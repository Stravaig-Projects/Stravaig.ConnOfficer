<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="clr-namespace:Stravaig.ConnOfficer.ViewModels.Data"
             x:DataType="vm:ContextTabViewModel"
             x:Class="Stravaig.ConnOfficer.Views.Data.ContextTabView">

    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="10" VerticalAlignment="Center">Context:</TextBlock>
            <TextBox Margin="10" Text="{Binding ContextName}" IsReadOnly="True"/>
            <TextBlock Margin="10" VerticalAlignment="Center">Cluster:</TextBlock>
            <TextBox Margin="10" Text="{Binding ClusterName}" IsReadOnly="True"/>
            <TextBlock Margin="10" VerticalAlignment="Center">User:</TextBlock>
            <TextBox Margin="10" Text="{Binding UserName}" IsReadOnly="True"/>
            <TextBlock Margin="10" VerticalAlignment="Center">Server:</TextBlock>
            <TextBox Margin="10" Text="{Binding Server}" IsReadOnly="True"/>
        </StackPanel>
    </StackPanel>


</UserControl>
