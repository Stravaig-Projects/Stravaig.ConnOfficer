<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Stravaig.ConnOfficer.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Stravaig.ConnOfficer.ViewModels"
             x:DataType="vm:LatestNotificationViewModel"
             x:Class="Stravaig.ConnOfficer.Views.LatestNotification">
    <StackPanel Orientation="Horizontal" PointerPressed="OnPointerPressed">
        <Svg
            Margin="10 2 10 2"
            Width="24"
            Height="24"
            Path="{Binding IconPath}"/>
        <TextBlock Text="{Binding Message}" VerticalAlignment="Center" />
        <FlyoutBase.AttachedFlyout>
            <Flyout Placement="Top">
                <views:NotificationItem DataContext="{Binding FullNotification}"/>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </StackPanel>
</UserControl>
