<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Stravaig.ConnOfficer.ViewModels"
             xmlns:views="clr-namespace:Stravaig.ConnOfficer.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Stravaig.ConnOfficer.Views.StatusBar"
             x:DataType="vm:MainWindowViewModel">
    <Border>
        <DockPanel>
            <views:LatestNotification DockPanel.Dock="Left"/>
            <!-- <views:Zoom DockPanel.Dock="Right" /> -->
        </DockPanel>
</Border>
</UserControl>
