<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:vm="using:Stravaig.ConnOfficer.ViewModels"
             x:DataType="vm:NotificationItemViewModel"
             x:Class="Stravaig.ConnOfficer.Views.NotificationItem">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Image Margin="0 2 10 2"
                   Width="24"
                   Height="24">
                <Image.Source>
                    <SvgImage Source="{Binding IconSource}"/>
                </Image.Source>
            </Image>
            <TextBlock Text="{Binding Code}"/>
            <TextBlock Text="{Binding Time}"/>
        </StackPanel>
        
        <Separator Margin="0,10,0,10" />

        <TextBlock Text="{Binding Message}"/>
        <TextBlock IsVisible="{Binding HasException}" Text="{Binding ExceptionDetails}" />
    </StackPanel>
</UserControl>
